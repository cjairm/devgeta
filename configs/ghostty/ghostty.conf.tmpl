term = xterm-256color

command = {{.ConfigPath}}/ghostty/starter.sh

window-padding-x = 10
window-padding-y = 10

macos-titlebar-style = hidden

background-opacity = 0.8
background-blur = true

{{if eq .Font "default"}}
font-size = 13
font-family = MesloLGLDZ Nerd Font Mono
font-family-bold = MesloLGLDZ Nerd Font Mono
font-family-italic = MesloLGLDZ Nerd Font Mono
{{end}}

{{if eq .Theme "default"}}
background = #282828
foreground = #d4be98

palette = 0=#63605e
