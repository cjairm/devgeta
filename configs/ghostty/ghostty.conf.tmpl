palette = 2=#a9b665
palette = 3=#d8a657
palette = 4=#7daea3
palette = 5=#d3869b
palette = 6=#89b482
palette = 7=#d4be98
palette = 8=#63605e
palette = 9=#ea6962
palette = 10=#a9b665
palette = 11=#d8a657
