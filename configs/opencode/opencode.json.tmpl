{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
{{- if .Plugins}}
  "plugins": [{{range $i, $p := .Plugins}}{{if $i}}, {{end}}{{$p}}{{end}}],
{{- end}}
{{- if .Instructions}}
  "instructions": [{{range $i, $p := .Instructions}}{{if $i}}, {{end}}{{$p}}{{end}}],
{{- end}}
  "agents": {
    "build": {
      "color": "#fe8019"
    },
    "plan": {
      "color": "#d3869b"
    }
  },
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "**/.env", "effect": "deny" },
    { "action": "read", "resource": "**/.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "**/envs/*.js", "effect": "deny" },
    { "action": "read", "resource": "./secrets/**", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "~/.ssh/**", "effect": "deny" },
    { "action": "read", "resource": "**/.ssh/**", "effect": "deny" },
    { "action": "read", "resource": "**/id_rsa", "effect": "deny" },
    { "action": "read", "resource": "**/id_ed25519", "effect": "deny" },
    { "action": "read", "resource": "**/id_ecdsa", "effect": "deny" },
    { "action": "read", "resource": "~/.aws/**", "effect": "deny" },
    { "action": "read", "resource": "**/.aws/**", "effect": "deny" },
    { "action": "read", "resource": "~/.kube/**", "effect": "deny" },
    { "action": "read", "resource": "**/.kube/**", "effect": "deny" },
    { "action": "read", "resource": "~/.config/gcloud/**", "effect": "deny" },
    { "action": "read", "resource": "**/.config/gcloud/**", "effect": "deny" },
    { "action": "read", "resource": "~/.azure/**", "effect": "deny" },
    { "action": "read", "resource": "**/.azure/**", "effect": "deny" },
    { "action": "read", "resource": "~/.npmrc", "effect": "deny" },
    { "action": "read", "resource": "**/.npmrc", "effect": "deny" },
    { "action": "read", "resource": "~/.pypirc", "effect": "deny" },
    { "action": "read", "resource": "**/.pypirc", "effect": "deny" },
    { "action": "read", "resource": "~/.netrc", "effect": "deny" },
    { "action": "read", "resource": "**/.netrc", "effect": "deny" },
    { "action": "read", "resource": "~/.git-credentials", "effect": "deny" },
    { "action": "read", "resource": "**/.git-credentials", "effect": "deny" },
    { "action": "read", "resource": "~/.docker/config.json", "effect": "deny" },
    { "action": "read", "resource": "**/.docker/config.json", "effect": "deny" },
    { "action": "read", "resource": "~/.pgpass", "effect": "deny" },
    { "action": "read", "resource": "**/.pgpass", "effect": "deny" },
    { "action": "read", "resource": "~/.zsh_history", "effect": "deny" },
    { "action": "read", "resource": "**/.zsh_history", "effect": "deny" },
    { "action": "read", "resource": "~/.bash_history", "effect": "deny" },
    { "action": "read", "resource": "**/.bash_history", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git push --force*", "effect": "ask" },
    { "action": "shell", "resource": "git push -f*", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "gh repo delete *", "effect": "ask" },
    { "action": "shell", "resource": "gh release delete *", "effect": "ask" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": ".git/**", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": {{.ScratchDirGlob}}, "effect": "allow" }
  ],
  "formatter": {
    "devgeta-js": {
      "command": [
        "sh",
        "-c",
        "M=\"$HOME/.local/share/nvim/mason/bin\"; export ESLINT_D_PPID=0 ESLINT_D_IDLE=15; [ -x \"$M/eslint_d\" ] && \"$M/eslint_d\" \"$FILE\" --fix >/dev/null 2>&1; d=$(dirname \"$FILE\"); while [ \"$d\" != / ] && [ \"$d\" != . ] && [ ! -x \"$d/node_modules/.bin/prettier\" ]; do d=$(dirname \"$d\"); done; P=\"$d/node_modules/.bin/prettier\"; [ -x \"$P\" ] || P=\"$M/prettier\"; [ -x \"$P\" ] && \"$P\" \"$FILE\" --write >/dev/null 2>&1; true"
      ],
      "extensions": [".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs"]
    },
    "devgeta-prettier": {
      "command": [
        "sh",
        "-c",
        "M=\"$HOME/.local/share/nvim/mason/bin\"; d=$(dirname \"$FILE\"); while [ \"$d\" != / ] && [ \"$d\" != . ] && [ ! -x \"$d/node_modules/.bin/prettier\" ]; do d=$(dirname \"$d\"); done; P=\"$d/node_modules/.bin/prettier\"; [ -x \"$P\" ] || P=\"$M/prettier\"; [ -x \"$P\" ] && \"$P\" \"$FILE\" --write >/dev/null 2>&1; true"
      ],
      "extensions": [
        ".json",
        ".css",
        ".scss",
        ".less",
        ".yaml",
        ".yml",
        ".md",
        ".markdown",
        ".html"
      ]
    },
    "devgeta-python": {
      "command": [
        "sh",
        "-c",
        "M=\"$HOME/.local/share/nvim/mason/bin\"; [ -x \"$M/isort\" ] && \"$M/isort\" \"$FILE\" >/dev/null 2>&1; [ -x \"$M/black\" ] && \"$M/black\" \"$FILE\" >/dev/null 2>&1; true"
      ],
      "extensions": [".py"]
    },
    "devgeta-go": {
      "command": [
        "sh",
        "-c",
        "M=\"$HOME/.local/share/nvim/mason/bin\"; [ -x \"$M/goimports\" ] && \"$M/goimports\" -w \"$FILE\" >/dev/null 2>&1; [ -x \"$M/gofumpt\" ] && \"$M/gofumpt\" -w \"$FILE\" >/dev/null 2>&1; [ -x \"$M/golines\" ] && \"$M/golines\" -w \"$FILE\" >/dev/null 2>&1; true"
      ],
      "extensions": [".go"]
    },
    "devgeta-lua": {
      "command": [
        "sh",
        "-c",
        "M=\"$HOME/.local/share/nvim/mason/bin\"; [ -x \"$M/stylua\" ] && \"$M/stylua\" \"$FILE\" >/dev/null 2>&1; true"
      ],
      "extensions": [".lua"]
    },
    "devgeta-shell": {
      "command": [
        "sh",
        "-c",
        "M=\"$HOME/.local/share/nvim/mason/bin\"; [ -x \"$M/shfmt\" ] && \"$M/shfmt\" -w \"$FILE\" >/dev/null 2>&1; true"
      ],
      "extensions": [".sh", ".bash"]
    },
    "devgeta-clang": {
      "command": [
        "sh",
        "-c",
        "M=\"$HOME/.local/share/nvim/mason/bin\"; [ -x \"$M/clang-format\" ] && \"$M/clang-format\" -i \"$FILE\" >/dev/null 2>&1; true"
      ],
      "extensions": [".c", ".h", ".cpp", ".hpp"]
    }
  }
}
